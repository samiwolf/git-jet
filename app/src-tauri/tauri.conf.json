{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Jet",
  "version": "0.1.2",
  "identifier": "com.gitjet.soft",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Git Jet",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "additionalBrowserArgs": "--remote-debugging-port=9222 --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
